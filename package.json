{
  "name": "esports-manager-text-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "validate:data": "node --experimental-strip-types src/utils/checkStaticData.ts",
    "example:match": "node --experimental-strip-types src/utils/exampleMatch.ts",
    "test": "node --experimental-strip-types --test src/utils/gameState.test.mjs src/utils/management.test.mjs src/utils/matchPreparation.test.mjs src/utils/simulateMatch.test.mjs src/utils/season.test.mjs src/utils/matchEngineV2.test.mjs src/utils/experience.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "8.1.4"
  }
}
